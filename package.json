{
  "name": "velora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=lib/**/*.ts --coverage.reporter=text",
    "loadtest": "node scripts/loadtest/run-loadtest.mjs",
    "bench:rate-limit": "tsx bench/rate-limit.ts",
    "bench:concurrency": "tsx bench/optimistic-concurrency.ts",
    "bench:latency": "tsx bench/latency.ts",
    "bench:lighthouse": "node bench/lighthouse.mjs",
    "bench:all": "npm run bench:rate-limit && npm run bench:concurrency && npm run bench:latency && npm run test:coverage",
    "ingest:jobs": "tsx scripts/ingest-jobs.ts",
    "bench:jobs:queries": "tsx bench/job-search/generate-queries.ts",
    "bench:jobs:eval": "tsx bench/job-search/eval-retrieval.ts",
    "bench:jobs:hnsw": "tsx bench/job-search/bench-hnsw-10k.ts",
    "bench:jobs:incremental": "tsx bench/job-search/bench-incremental.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.49.8",
    "framer-motion": "^12.38.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.16.0",
    "next": "^15.5.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^3.0.0",
    "autocannon": "^8.0.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "hyparquet": "^1.33.1",
    "hyparquet-compressors": "^1.1.3",
    "pg": "^8.23.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
